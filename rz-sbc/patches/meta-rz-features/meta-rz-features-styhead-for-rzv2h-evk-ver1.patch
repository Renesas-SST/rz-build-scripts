+From 6c5fe218bda111b3ab92337b423e24253bc2bf42 Mon Sep 17 00:00:00 2001
+From: Cong Nguyen <cong.nguyen.zn@renesas.com>
+Date: Tue, 15 Apr 2025 03:43:56 +0000
+Subject: [PATCH 16/19] Add DRP Codec and OpenCVA node
+
+Upstream-Status: Pending
+---
+ arch/arm64/boot/dts/renesas/r9a09g057.dtsi    | 21 +++++++++++++++++++
+ .../boot/dts/renesas/r9a09g057h4-evk-ver1.dts |  7 +++++++
+ 2 files changed, 28 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
+index bb6de96b1..9d26e9206 100644
+--- a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
++++ b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
+@@ -1262,6 +1262,27 @@ xspi: spi@11030000 {
+ 			status = "disabled";
+ 		};
+ 
++		opencva0: opencva@C0000000 {
++			compatible = "renesas,rzv2h-opencva";
++			reg = <0x00 0xC0000000 0x00 0x07D00000>;
++			status = "okay";
++		};
++
++		drp1: drp1@18000000 {
++			compatible = "renesas,rzv2h-drp";
++			reg = <0 0x18000000 0 0x1000000>;
++			interrupts = <GIC_SPI 912 IRQ_TYPE_LEVEL_HIGH>,
++				     	 <GIC_SPI 913 IRQ_TYPE_LEVEL_HIGH>;
++			resets = <&cpg 252>;
++			status = "disabled";
++		};
++
++		codec0: codec {
++			reusable;
++			reg = <0x00 0xC7D00000 0x00 0x00300000>;
++			status = "okay";
++		};
++
+ 		tsu0: thermal@11000000 {
+ 			compatible = "renesas,tsu-r9a09g057";
+ 			reg = <0 0x11000000 0 0x1000>;
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts b/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts
