++int32_t R_DRP_DRP_Stop(addr_t drp_base_addr, int32_t ch, spinlock_t *lock)
++{
++    int32_t ret = R_DRP_SUCCESS;
++
++    if (0 != stop_prefetch_drp_drp(drp_base_addr))
++    {
++        ret = R_DRP_ERR_RESET;
++        goto end;
++    }
++
++    goto end;
++
++end:
++    return ret;
++}
