++static long drp_ioctl_start(struct file *filp, unsigned int cmd, unsigned long arg)
++{
++    int result = 0;
++    int i;
++    int j;
++    struct drp_priv *priv = drp_priv;
++    unsigned long flags;
++    struct drp_desc_info *desc_info = filp->private_data;
++#ifdef CONFIG_DRP_SUPPORT_MULTI_OS
++    int flag_drp_used = -1;
++    int flag_drp_init = -1;
