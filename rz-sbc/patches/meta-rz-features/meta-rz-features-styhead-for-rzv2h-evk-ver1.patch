-+static void enable_addr_relocatable(addr_t drp_base_addr, uint64_t* addr)
-+{
-+    int i;
-+
-+    for( i=0; i<256; i++ )
-+    {
-+        uint32_t bit32_24 = (uint32_t)(*addr)       & 0xFF000000;
