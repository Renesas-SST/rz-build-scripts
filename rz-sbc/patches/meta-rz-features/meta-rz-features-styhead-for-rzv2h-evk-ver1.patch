-+                            (BIT_CMN_RST   << 28) |
-+                            (BIT_DRPOIF_RST<< 27) |
-+                            (BIT_DRPIIF_RST<< 26) |
-+                            (BIT_CHOx_RST  << 16) |
-+                            (BIT_DSCC_RST  <<  9) |
-+                            (BIT_CFGW_RST  <<  8) |
