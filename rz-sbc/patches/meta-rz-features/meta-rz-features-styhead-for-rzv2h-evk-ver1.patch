+++ meta-rz-features/meta-rz-drpai/recipes-kernel/linux/linux-yocto/0019-Add-drpai-node-and-udmabuf-to-device-tree.patch	2025-04-22 08:14:41.969672274 +0000
@@ -0,0 +1,72 @@
+From 332e61e5030ef6cb07832a7926a9c6dabcb5fba2 Mon Sep 17 00:00:00 2001
+From: Cong Nguyen <cong.nguyen.zn@renesas.com>
+Date: Tue, 22 Apr 2025 07:23:50 +0000
+Subject: [PATCH 19/19] Add drpai node and udmabuf to device tree
+
+Upstream-Status: Pending
+
+Signed-off-by: Cong Nguyen <cong.nguyen.zn@renesas.com>
+---
+ arch/arm64/boot/dts/renesas/r9a09g057.dtsi        | 12 ++++++++++++
+ .../boot/dts/renesas/r9a09g057h4-evk-ver1.dts     | 15 +++++++++++++++
+ 2 files changed, 27 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
+index 9d26e9206..fcfc6e2c6 100644
+--- a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
++++ b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
+@@ -1675,6 +1675,18 @@ xhci1: usb@15860000 {
+  			phy-names = "usb1";
+  			status = "disabled";
+  		};
++
++		drpai0: drpai@16800000 {
++			compatible = "renesas,rzv2h-drpai";
++			reg = <0 0x17000000 0 0x1000000>,
++				<0 0x16800000 0 0x400000>;
++			interrupts = <GIC_SPI 914 IRQ_TYPE_LEVEL_HIGH>,
++				<GIC_SPI 915 IRQ_TYPE_LEVEL_HIGH>,
++				<GIC_SPI 916 IRQ_TYPE_LEVEL_HIGH>,
++				<GIC_SPI 917 IRQ_TYPE_LEVEL_HIGH>;
++			resets = <&cpg 253>;
++			status = "disabled";
++		};
+ 	};
+ 
+ 	thermal-zones {
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts b/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts
+index 4e32a9fef..b7cf2ddee 100644
+--- a/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts
++++ b/arch/arm64/boot/dts/renesas/r9a09g057h4-evk-ver1.dts
+@@ -236,6 +236,15 @@ osc1: cec-clock {
+ 		#clock-cells = <0>;
+ 		clock-frequency = <12000000>;
+ 	};
++
++	udmabuf@0 {
++		compatible = "ikwzm,u-dma-buf";
++		device-name = "udmabuf0";
++		minor-number = <0>;
++		size = <0x4000000>; // 64MiB
++		dma-coherent;
++		memory-region = <&image_buf0>;
++	};
+ };
+ 
+ &pinctrl {
+@@ -753,6 +762,12 @@ &cmtw0 {
+ 	status = "okay";
+ };
+ 
++&drpai0 {
++	memory-region = <&drp_reserved>;
++	image-memory-region = <&image_buf0>;
++	status = "okay";
++};
++
+ &cmtw1 {
+ 	status = "okay";
+ };
+-- 
+2.25.1
+
