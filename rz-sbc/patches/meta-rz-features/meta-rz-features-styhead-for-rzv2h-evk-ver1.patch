-+    if(0 == write_ctr_lock_status)
-+    {
-+        unlock_write_control(addr);
-+    }
-+    if (PROCESS_CONTEXT == context)
-+    {
-+        spin_unlock_irqrestore(lock, flags);
-+    }
-+    return result;
-+}
