++{
++    int32_t ret = -1;
++    uint32_t loop;
++
++    loop = 0;
++    while ((100 > loop) && (0 != ret))
++    {
++        if (0 == check_reg(addr, (val << bit), (1 << bit), 0))
++        {
++            ret = 0;
++            break;
++        }
++        udelay(1);
++        loop++;
++    }
++
++    loop = 0;
++    while ((100 > loop) && (0 != ret))
++    {
++        if (0 == check_reg(addr, (val << bit), (1 << bit), 0))
++        {
++            ret = 0;
++            break;
++        }
++        usleep_range(100, 200);
++        loop++;
++    }
++
++    return ret;
++}
