-+    if (0 != cpg_check(cpg_base_addr + CPG_RSTMON_7_REG, BIT_NUM_RSTMON, 0x0u))
-+    {
-+        ret = R_DRP_ERR_RESET;
-+        goto end;
-+    }
-+
-+    goto end;
-+
-+end:
-+    return ret;
-+}
