++static int8_t drp_cpg_reset(uint32_t ch)
++{
++    int8_t retval = R_DRP_SUCCESS;
++    struct drp_priv *priv = drp_priv;
++    int r_data;
++    int32_t i = 0;
++    bool is_stop = false;
