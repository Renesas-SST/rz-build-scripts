-+    // Reset OFF
-+    cpg_set(cpg_base_addr + CPG_RST_15_REG, 12, 0x1u);  // DRP.ARESETn
-+
-+    // RSTMON
-+    if (0 != cpg_check(cpg_base_addr + CPG_RSTMON_7_REG, 13, 0x0u))  // DRP.ARESETn
-+    {
-+        goto error_init;
-+    }
-+
-+    goto end;
