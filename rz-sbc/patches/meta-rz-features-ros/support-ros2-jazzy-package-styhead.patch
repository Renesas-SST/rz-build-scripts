diff --git a/yocto_rzsbc_board/meta-rz-features-ros/meta-rzv2h-ros-jazzy/conf/layer.conf b/yocto_rzsbc_board/meta-rz-features-ros/meta-rzv2h-ros-jazzy/conf/layer.conf
