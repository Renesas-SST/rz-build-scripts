index 0000000..c89d199
--- /dev/null
+++ b/yocto_rzsbc_board/meta-rz-features-ros/meta-rzv2h-ros-jazzy/conf/layer.conf
@@ -0,0 +1,16 @@
+# We have a conf and classes directory, add to BBPATH
+BBPATH .= ":${LAYERDIR}"
+
+# We have recipes-* directories, add to BBFILES
+BBFILES += "${LAYERDIR}/recipes-*/*/*.bb \
+            ${LAYERDIR}/recipes-*/*/*.bbappend"
+
+BBFILE_COLLECTIONS += "meta-rzv2h-ros-jazzy"
+BBFILE_PATTERN_meta-rzv2h-ros-jazzy = "^${LAYERDIR}/"
+BBFILE_PRIORITY_meta-rzv2h-ros-jazzy = "99"
+
+LAYERDEPENDS_meta-rzv2h-ros-jazzy = "core"
+LAYERSERIES_COMPAT_meta-rzv2h-ros-jazzy = "styhead"
+
+require conf/include/toolchain_host.inc
+require conf/include/toolchain_target.inc
\ No newline at end of file
