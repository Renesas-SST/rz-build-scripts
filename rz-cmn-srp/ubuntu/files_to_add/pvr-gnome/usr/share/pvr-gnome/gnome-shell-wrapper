#!/bin/sh
# GPU-aware gnome-shell launcher.
# On PowerVR (V4H): inject PVR EGL/GLES/GBM stack ahead of Mesa.
# On Panfrost/Mesa (G2L): pass through to stock gnome-shell — Mesa works natively.
# Installed as /usr/bin/gnome-shell via dpkg-divert.

# Detect PowerVR GPU: check if any DRI card is driven by pvrsrvkm
has_pvr_gpu() {
    for dev in /sys/class/drm/card*/device; do
        [ -d "$dev" ] || continue
        drv=$(readlink "$dev/driver" 2>/dev/null) || continue
        case "${drv##*/}" in pvrsrvkm) return 0 ;; esac
    done
    return 1
}

if has_pvr_gpu; then
    export LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu/pvr${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_PRELOAD="/usr/lib/aarch64-linux-gnu/pvr/libpvr-gnome-shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
    export COGL_DRIVER=gles2
    export MUTTER_DEBUG_TRIPLE_BUFFERING=never
    export MESA_LOADER_DRIVER_OVERRIDE=zink
    export LIBGL_KOPPER_DISABLE=1
    export VK_DRIVER_FILES=/etc/vulkan/icd.d/powervr_icd.json
fi

exec /usr/bin/gnome-shell.real "$@"
