#!/bin/sh
# GPU-aware rviz2 launcher.
# On PowerVR (V4H): preload librviz-nomsaa.so — MSAA GLX drawables present
#   black on Mesa zink and rviz2 hard-codes FSAA 4.
# On Panfrost/Mesa (G2L): pass through — MSAA works on Mesa.
# Installed over /opt/ros/<distro>/bin/rviz2 via dpkg-divert;
# the real binary is "$0.real".

has_pvr_gpu() {
    for dev in /sys/class/drm/card*/device; do
        [ -d "$dev" ] || continue
        drv=$(readlink "$dev/driver" 2>/dev/null) || continue
        case "${drv##*/}" in pvrsrvkm) return 0 ;; esac
    done
    return 1
}

if has_pvr_gpu; then
    export LD_PRELOAD="librviz-nomsaa.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$(readlink -f "$0").real" "$@"
