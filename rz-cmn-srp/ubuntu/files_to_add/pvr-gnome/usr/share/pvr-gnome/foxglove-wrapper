#!/bin/sh
# GPU-aware Foxglove Studio launcher.
# On PowerVR (V4H): force X11 + disable GPU compositing — Ozone/Wayland garbles
#   text via cross-process dma-buf failure on zink.
# On Panfrost/Mesa (G2L): pass through — native Wayland works.
# Installed over /opt/Foxglove/foxglove-studio via dpkg-divert;
# the real binary is "$0.real".

has_pvr_gpu() {
    for dev in /sys/class/drm/card*/device; do
        [ -d "$dev" ] || continue
        drv=$(readlink "$dev/driver" 2>/dev/null) || continue
        case "${drv##*/}" in pvrsrvkm) return 0 ;; esac
    done
    return 1
}

if has_pvr_gpu; then
    exec "$(readlink -f "$0").real" --ozone-platform=x11 --ignore-gpu-blocklist --disable-gpu-compositing "$@"
fi

exec "$(readlink -f "$0").real" "$@"
